{
  "ollama_url": "http://127.0.0.1:11434",
  "model": "qwen2.5:3b",
  "system": "You are a helpful technical assistant running locally on an Android phone. Be concise and give working code when asked.",
  "stream": true,
  "keep_history": true,
  "max_history": 20,
  "tools_enabled": true,
  "auto_approve": "all",
  "command_timeout": 300,
  "max_output_chars": 4000,
  "max_steps": 25,
  "max_retries": 2,
  "options": {
    "top_p": 0.95,
    "top_k": 40,
    "repeat_penalty": 1.1,
    "num_ctx": 8192,
    "num_predict": -1
  },
  "backend": "freellmapi",
  "freellmapi_url": "http://localhost:3001",
  "freellmapi_key": "",
  "routing": true,
  "default_route": "shell",
  "router_model": null,
  "routes": {
    "web": {
      "description": "looking things up online: searching, news, prices, docs, websites",
      "model": "auto",
      "fallbacks": [
        "qwen2.5:3b",
        "qwen2.5-coder:3b"
      ],
      "tools": true,
      "options": {
        "temperature": 0.3
      },
      "keywords": [
        "search",
        "google",
        "internet",
        "web",
        "online",
        "look up",
        "lookup",
        "browse",
        "url",
        "https?",
        "latest",
        "news",
        "weather",
        "price",
        "current",
        "today",
        "recent",
        "find out",
        "documentation",
        "docs"
      ]
    },
    "code": {
      "description": "writing, fixing, explaining or running code and scripts",
      "model": "auto:smart",
      "fallbacks": [
        "qwen2.5:3b",
        "qwen2.5-coder:3b"
      ],
      "tools": true,
      "options": {
        "temperature": 0.2
      },
      "keywords": [
        "code",
        "script",
        "python",
        "javascript",
        "js",
        "html",
        "css",
        "bash script",
        "function",
        "class",
        "bug",
        "debug",
        "error",
        "traceback",
        "exception",
        "compile",
        "program",
        "app",
        "api",
        "regex",
        "refactor",
        "json",
        "sql",
        "rust",
        "java",
        "c\\+\\+",
        "node",
        "npm",
        "import",
        "syntax",
        "webapp",
        "web app",
        "website",
        "web page",
        "webpage",
        "frontend",
        "front end",
        "button",
        "ui"
      ]
    },
    "shell": {
      "description": "doing things on the device: files, folders, installing, running commands",
      "model": "auto",
      "fallbacks": [
        "qwen2.5:3b",
        "qwen2.5-coder:3b"
      ],
      "tools": true,
      "options": {
        "temperature": 0.3
      },
      "keywords": [
        "install",
        "run",
        "file",
        "files",
        "folder",
        "directory",
        "download",
        "termux",
        "pkg",
        "pip",
        "command",
        "terminal",
        "delete",
        "remove",
        "create",
        "make",
        "move",
        "copy",
        "rename",
        "git",
        "clone",
        "list",
        "check",
        "update",
        "upgrade",
        "disk",
        "storage",
        "process",
        "zip",
        "unzip",
        "convert",
        "find",
        "search",
        "open",
        "set up",
        "setup",
        "configure",
        "server",
        "start",
        "stop",
        "kill"
      ]
    },
    "chat": {
      "description": "conversation, questions, explanations, writing text, translation",
      "model": "auto:fast",
      "fallbacks": [
        "qwen2.5:3b",
        "qwen2.5-coder:3b"
      ],
      "tools": true,
      "options": {
        "temperature": 0.7
      },
      "keywords": [
        "hi",
        "hello",
        "hey",
        "thanks",
        "thank you",
        "explain",
        "what is",
        "what are",
        "who is",
        "why",
        "how does",
        "tell me",
        "story",
        "poem",
        "joke",
        "translate",
        "summarize",
        "summary",
        "meaning",
        "define",
        "opinion",
        "advice",
        "write an email"
      ]
    }
  },
  "workspace": "/storage/emulated/0/Download/AI agent"
}
